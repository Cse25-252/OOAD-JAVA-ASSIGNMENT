<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="banking.gui.controller.TransactionController"
      alignment="CENTER"
      spacing="15"
      prefWidth="650"
      prefHeight="600"
      style="-fx-padding: 30;">

    <Label text="ACCESS BANK BOTSWANA"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="TRANSACTION MANAGEMENT"
           style="-fx-font-size: 18px;"/>

    <TextField fx:id="transactionIdField"
               promptText="Enter Transaction ID"
               maxWidth="300"/>

    <TextField fx:id="accountNumberField"
               promptText="Enter Account Number"
               maxWidth="300"/>

    <ComboBox fx:id="transactionTypeBox"
              promptText="Select Transaction Type"
              maxWidth="300"/>

    <TextField fx:id="amountField"
               promptText="Enter Amount (BWP)"
               maxWidth="300"/>

    <DatePicker fx:id="transactionDatePicker"
                promptText="Select Transaction Date"
                maxWidth="300"/>

    <Button text="Process Transaction"
            onAction="#handleProcessTransaction"/>

    <Label fx:id="messageLabel"
           text="Enter transaction details."/>

    <Button text="Back to Dashboard"
            onAction="#handleBack"/>

</VBox>
