<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="banking.gui.controller.CustomerManagementController"
      alignment="CENTER"
      spacing="10">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <Label text="ACCESS BANK BOTSWANA"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Customer Management"
           style="-fx-font-size: 18px;"/>

    <ComboBox fx:id="customerTypeBox"
              promptText="Select Customer Type"
              maxWidth="350"/>

    <Label text="Basic Details"/>

    <TextField fx:id="customerIdField" promptText="Customer ID" maxWidth="350"/>
    <TextField fx:id="nameField" promptText="Full Name / Business Name" maxWidth="350"/>
    <TextField fx:id="addressField" promptText="Address" maxWidth="350"/>
    <TextField fx:id="phoneField" promptText="Contact Number" maxWidth="350"/>
    <TextField fx:id="emailField" promptText="Email" maxWidth="350"/>

    <Label text="Individual Customer Details"/>

    <TextField fx:id="omangField" promptText="OMANG" maxWidth="350"/>
    <TextField fx:id="dateOfBirthField" promptText="Date of Birth" maxWidth="350"/>
    <TextField fx:id="employerNameField" promptText="Employer Name" maxWidth="350"/>
    <TextField fx:id="employerAddressField" promptText="Employer Address" maxWidth="350"/>

    <Label text="Company Customer Details"/>

    <TextField fx:id="registrationNumberField" promptText="Registration Number" maxWidth="350"/>
    <TextField fx:id="natureOfBusinessField" promptText="Nature of Business" maxWidth="350"/>
    <TextField fx:id="companyDocumentsField" promptText="Company Registration Documents" maxWidth="350"/>
    <TextField fx:id="signatoryDocumentsField" promptText="Authorised Signatory Documents" maxWidth="350"/>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Register Customer" onAction="#handleRegister"/>
        <Button text="Search Customer" onAction="#handleSearch"/>
    </HBox>

    <Label fx:id="messageLabel" wrapText="true"/>

    <Button text="Back to Dashboard" onAction="#handleBack"/>

</VBox>
